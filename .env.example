# offline is deterministic and requires no cloud credentials.
AGENT_DRIVER=offline

# To enable Bedrock Converse, set both values and provide AWS credentials via
# the normal AWS credential chain. Never put credentials in this file.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1

# Optional; defaults to storage/app.sqlite.
# APP_DB_PATH=storage/app.sqlite
